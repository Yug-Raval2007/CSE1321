volume=float(input("Enter input loudness (dB): "))
threshold=float(input("Enter threshold (dB): "))
print("Select a ratio:")
print("1 - 3:1","\n2 - 4:1","\n3 - 10:1")
ratio=input("> ")

match ratio:
    case "1":
        divisor=3
    case "2":
        divisor=4
    case "3":
        divisor=10
    case __:
        divisor=2
print(f"You have selected the {divisor}:1 ratio")
if volume>threshold:
    compressed_remainder=(volume-threshold)/divisor
    output=threshold+compressed_remainder
else:
    output=volume
print(f"Output Level: {output} dB")
