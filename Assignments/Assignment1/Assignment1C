sample_rate=int(input("Enter Sample Rate (in Hz): "))
buffer_size=int(input("Enter Buffer Size: "))
track_length=int(input("Enter track length (in seconds): "))

sample_data=sample_rate*track_length
full_buffer=sample_data//buffer_size
remaining_buffer=sample_data%buffer_size

print(f"Processed {full_buffer} full buffers with {remaining_buffer} leftover samples.")
